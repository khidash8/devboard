            "name": "Projects",
            "item": [
                {
                    "name": "Create Project",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "const response = pm.response.json();\r\npm.environment.set('project_id', response.id);\r\n\r\npm.test('responds with 201 Created', () => {\r\n  pm.response.to.have.status(201);\r\n});\r\n\r\npm.test('the created project has the correct name', () => {\r\n  const body = pm.response.json();\r\n  pm.expect(body.name).to.eql('Test Project');\r\n  pm.expect(body.id).to.be.a('string');\r\n});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [],
                        "body": {
                            "mode": "raw",
                            "raw": "{ \"name\": \"Test Project\", \"slug\": \"test-project\" }",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{base_url}}/api/projects",
                            "host": [
